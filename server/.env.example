PORT=4000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-value
DATABASE_PATH=./data/app.db
DOCUMENT_STORAGE_DIR=./storage/documents
BACKUP_DIR=./storage/backups
ENABLE_BACKUP_SCHEDULE=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
NODE_ENV=development

# Nightly billing (03:00 Asia/Shanghai). Only contracts an Admin has switched to
# automatic billing are touched; set to false to disable the job entirely.
ENABLE_CHARGE_GENERATION_SCHEDULE=true
