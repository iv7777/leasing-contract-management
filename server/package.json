{
  "name": "@lcm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cd .. && npm run build --workspace=shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "cd .. && npm run build --workspace=shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "reset-password": "tsx src/db/resetPassword.ts",
    "set-email": "tsx src/db/setEmail.ts",
    "import-contract": "tsx src/db/importContract.ts",
    "backup": "tsx src/jobs/backup.ts",
    "restore-backup": "tsx src/db/restoreBackup.ts",
    "pretest": "cd .. && npm run build --workspace=shared",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@lcm/shared": "*",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "multer": "^2.0.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
