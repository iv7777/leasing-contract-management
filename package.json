{
  "name": "leasing-contract-management",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run build:shared && npm run dev --workspace=server",
    "dev:web": "npm run build:shared && npm run dev --workspace=web",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server",
    "reset-password": "npm run reset-password --workspace=server --",
    "backup": "npm run backup --workspace=server",
    "test:server": "npm run test --workspace=server"
  }
}
